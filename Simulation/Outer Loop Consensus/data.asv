%% ============================================
%  DATA ANALYSIS - FROM out.logsout
%  Lấy dữ liệu từ Signal Logging của Simulink
% ============================================

%% ============================================
%  1. KIỂM TRA VÀ LẤY DỮ LIỆU TỪ out.logsout
% ============================================

fprintf('=== LOADING DATA FROM out.logsout ===\n');

logsout = out.logsout;


% Lấy dữ liệu p (vị trí)
p_data = logsout.getElement('p');
t = p_data.Values.Time;
p_vals = p_data.Values.Data;

    v_data = logsout.getElement('v');
    v_vals = v_data.Values.Data;

    tout_data = logsout.getElement('tout');
    t = p_data.Values.Time;

% Xác định kích thước của p
fprintf('Original p size: [%d, %d, %d]\n', size(p_vals));

% Reshape p từ [30,1,Nt] hoặc [Nt,30] thành [Nt, 10, 3]
if ndims(p_vals) == 3 && size(p_vals,1) == 30 && size(p_vals,3) > 1
    % Dạng [30, 1, Nt]
    p_vals = squeeze(p_vals);      % [30, Nt]
    p_vals = p_vals';              % [Nt, 30]
    Nt = size(p_vals, 1);
    n = 10;
    d = 3;
    p = reshape(p_vals, [Nt, n, d]);
elseif ndims(p_vals) == 2 && size(p_vals,2) == 30
    % Dạng [Nt, 30]
    Nt = size(p_vals, 1);
    n = 10;
    d = 3;
    p = reshape(p_vals, [Nt, n, d]);
else
    error('Unexpected p dimensions: [%d, %d, %d]', size(p_vals));
end

% Xử lý vận tốc
if has_velocity
    fprintf('Original v size: [%d, %d, %d]\n', size(v_vals));
    if ndims(v_vals) == 3 && size(v_vals,1) == 30
        v_vals = squeeze(v_vals);
        v_vals = v_vals';
        v = reshape(v_vals, [Nt, n, d]);
    elseif ndims(v_vals) == 2 && size(v_vals,2) == 30
        v = reshape(v_vals, [Nt, n, d]);
    else
        v = v_vals;
    end
end

% Xử lý thời gian
if length(t) ~= Nt
    dt = 0.01;
    t = (0:Nt-1)' * dt;
    fprintf('Recreated time vector, dt=%.4f s\n', dt);
else
    dt = t(2) - t(1);
end

fprintf('Final p size: [%d, %d, %d]\n', size(p));
fprintf('Time: %.2f s, dt = %.4f s, Steps: %d\n', t(end), dt, Nt);

%% ============================================
%  2. LẤY DESIRED FORMATION (từ logsout nếu có)
% ============================================

if logsout.isElement('p_star')
    p_star_data = logsout.getElement('p_star');
    p_star = p_star_data.Values.Data;
    if size(p_star,1) == 10 && size(p_star,2) == 3
        % OK
    else
        p_star = p_star';
    end
    fprintf('Loaded p_star from logsout\n');
else
    % Tạo formation mong muốn (hình tròn bán kính 12)
    radius = 12;
    n = 10;
    angles = linspace(0, 2*pi, n+1)';
    angles = angles(1:end-1);
    p_star = radius * [cos(angles), sin(angles), zeros(n,1)];
    fprintf('Created default p_star (radius=12)\n');
end

%% ============================================
%  3. TÍNH TOÁN METRIC (đơn giản)
% ============================================

fprintf('=== CALCULATING METRICS ===\n');

% 3.1. Tâm đội hình
center_actual = squeeze(mean(p, 2));  % [Nt, 3]

% 3.2. Vận tốc trung bình
if has_velocity
    speed = squeeze(sqrt(sum(v.^2, 3)));
else
    % Tính từ p
    v_calc = diff(p, 1, 1) / dt;
    v_calc = [v_calc(1,:,:); v_calc];
    speed = squeeze(sqrt(sum(v_calc.^2, 3)));
end
avg_speed = mean(speed, 2);

% 3.3. Khoảng cách từ drone đến tâm
dist_to_center = zeros(Nt, n);
for i = 1:n
    dist_to_center(:,i) = squeeze(sqrt(sum((p(:,i,:) - center_actual).^2, 3)));
end

%% ============================================
%  4. VẼ HÌNH
% ============================================

fprintf('=== PLOTTING FIGURES ===\n');

colors = lines(n);

% Figure 1: 3D Trajectories
figure('Name', '3D Trajectories', 'Position', [100, 100, 1200, 800]);
hold on; grid on;
for i = 1:n
    plot3(squeeze(p(:,i,1)), squeeze(p(:,i,2)), squeeze(p(:,i,3)), ...
          'Color', colors(i,:), 'LineWidth', 0.8);
end
plot3(p_star(:,1), p_star(:,2), p_star(:,3), 'k*', 'MarkerSize', 12, 'LineWidth', 2);
xlabel('X (m)'); ylabel('Y (m)'); zlabel('Z (m)');
title('3D Trajectories of 10 Drones');
legend([arrayfun(@(x) sprintf('Drone %d', x), 1:n, 'UniformOutput', false), {'Desired'}], ...
       'Location', 'best', 'FontSize', 8);
view(45, 30);
axis equal;
saveas(gcf, 'Fig1_3D_Trajectories.png');

% Figure 2: XY Projection
figure('Name', 'XY Projection', 'Position', [100, 100, 800, 800]);
hold on; grid on;
for i = 1:n
    plot(squeeze(p(:,i,1)), squeeze(p(:,i,2)), 'Color', colors(i,:), 'LineWidth', 0.5);
end
plot(p_star(:,1), p_star(:,2), 'k*', 'MarkerSize', 12);
xlabel('X (m)'); ylabel('Y (m)');
title('XY Projection (Top View)');
axis equal;
saveas(gcf, 'Fig2_XY_Projection.png');

% Figure 3: Final Formation Snapshot
figure('Name', 'Final Formation', 'Position', [100, 100, 800, 800]);
hold on; grid on;
p_final = squeeze(p(end, :, :));
for i = 1:n
    scatter3(p_final(i,1), p_final(i,2), p_final(i,3), 80, colors(i,:), 'filled');
end
scatter3(p_final(1,1), p_final(1,2), p_final(1,3), 120, 'k', 'filled', 'DisplayName', 'Leader');
plot3(p_star(:,1), p_star(:,2), p_star(:,3), 'r*', 'MarkerSize', 12, 'DisplayName', 'Desired');
xlabel('X (m)'); ylabel('Y (m)'); zlabel('Z (m)');
title('Final Formation Snapshot');
axis equal; view(45, 30); legend('Location', 'best');
saveas(gcf, 'Fig3_Final_Snapshot.png');

% Figure 4: Average Speed
figure('Name', 'Average Speed', 'Position', [100, 100, 800, 600]);
plot(t, avg_speed, 'g-', 'LineWidth', 2);
xlabel('Time (s)'); ylabel('Speed (m/s)');
title('Average Speed of Formation');
grid on;
saveas(gcf, 'Fig4_Average_Speed.png');

% Figure 5: Distance to Center
figure('Name', 'Distance to Center', 'Position', [100, 100, 800, 600]);
for i = 1:n
    plot(t, dist_to_center(:,i), 'Color', colors(i,:), 'LineWidth', 0.5);
    hold on;
end
xlabel('Time (s)'); ylabel('Distance (m)');
title('Distance from Drone to Formation Center');
grid on;
saveas(gcf, 'Fig5_Distance_To_Center.png');

% Figure 6: Center Trajectory
figure('Name', 'Center Trajectory', 'Position', [100, 100, 800, 800]);
plot(center_actual(:,1), center_actual(:,2), 'b-', 'LineWidth', 2); hold on;
plot(mean(p_star,1), mean(p_star,2), 'r*', 'MarkerSize', 15);
xlabel('X (m)'); ylabel('Y (m)');
title('Formation Center Trajectory');
legend('Actual Center', 'Desired Center', 'Location', 'best');
axis equal; grid on;
saveas(gcf, 'Fig6_Center_Trajectory.png');

% Figure 7: Altitude (Z) of all drones
figure('Name', 'Altitude', 'Position', [100, 100, 800, 600]);
for i = 1:n
    plot(t, squeeze(p(:,i,3)), 'Color', colors(i,:), 'LineWidth', 0.5);
    hold on;
end
xlabel('Time (s)'); ylabel('Z (m)');
title('Altitude of Drones');
grid on;
saveas(gcf, 'Fig7_Altitude.png');

% Figure 8: Initial vs Final vs Desired
figure('Name', 'Initial vs Final', 'Position', [100, 100, 800, 800]);
p_initial = squeeze(p(1, :, :));
hold on; grid on;
plot3(p_initial(:,1), p_initial(:,2), p_initial(:,3), 'ro', 'MarkerSize', 10, 'DisplayName', 'Initial');
plot3(p_final(:,1), p_final(:,2), p_final(:,3), 'bs', 'MarkerSize', 10, 'DisplayName', 'Final');
plot3(p_star(:,1), p_star(:,2), p_star(:,3), 'k*', 'MarkerSize', 12, 'DisplayName', 'Desired');
xlabel('X (m)'); ylabel('Y (m)'); zlabel('Z (m)');
title('Initial vs Final vs Desired Positions');
legend('Location', 'best');
axis equal; view(45, 30);
saveas(gcf, 'Fig8_Initial_Final_Desired.png');

%% ============================================
%  5. SUMMARY
% ============================================

fprintf('\n========================================\n');
fprintf('          SIMULATION SUMMARY\n');
fprintf('========================================\n');
fprintf('Number of drones: %d\n', n);
fprintf('Simulation time: %.2f s\n', t(end));
fprintf('Mean speed: %.4f m/s\n', mean(avg_speed));
fprintf('Max speed: %.4f m/s\n', max(avg_speed));
fprintf('Final center position: (%.2f, %.2f, %.2f)\n', center_actual(end,1), center_actual(end,2), center_actual(end,3));
fprintf('Desired center position: (%.2f, %.2f, %.2f)\n', mean(p_star,1));
fprintf('========================================\n');

fprintf('\n✅ Analysis complete! 8 figures saved.\n');